# Set hostname
CONFIG_DEFAULT_HOSTNAME="a04s"

# Disabling samsung securities
CONFIG_UH=n
CONFIG_UH_RKP=n
CONFIG_UH_LKMAUTH=n
CONFIG_UH_LKM_BLOCK=n
CONFIG_RKP_CFP_JOPP=n
CONFIG_RKP_CFP=n
CONFIG_SECURITY_DEFEX=n
CONFIG_PROCA=n
CONFIG_FIVE=n
CONFIG_RKP=n
CONFIG_KDP_NS=n
CONFIG_KDP=n

# KernelSU
CONFIG_KSU=y
